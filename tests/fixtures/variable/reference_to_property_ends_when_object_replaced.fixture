// test: replacing the object leaves a reference to its old property alone
// feature: hover
// expect: $r = 'old'
// expect_absent: 'new'
---
<?php

class Foo {
    public string $bar = '';
}

function test(Foo $foo): void {
    $foo->bar = 'old';
    $r = &$foo->bar;
    $foo = new Foo();
    $foo->bar = 'new';
    echo $<>r;
}
